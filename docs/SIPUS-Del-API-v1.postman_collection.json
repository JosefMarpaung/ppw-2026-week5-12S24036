{
  "info": {
    "_postman_id": "sipus-del-week9-collection",
    "name": "PPW Week 9 - SIPUS-Del Web Services",
    "description": "Koleksi Postman Resmi Pengujian SOAP & RESTful API v1 SIPUS-Del (Minggu 9)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. SOAP - Check Clearance Status (Yudisium)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://sipus.del.ac.id/soap\">\n    <soap:Body>\n        <m:CheckClearanceRequest>\n            <m:nim_peminjam>12S24036</m:nim_peminjam>\n        </m:CheckClearanceRequest>\n    </soap:Body>\n</soap:Envelope>"
        },
        "url": {
          "raw": "http://localhost:8000/soap/sipus"
        }
      }
    },
    {
      "name": "2. Auth - Login Pustakawan (Stateless Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"pustakawan@del.ac.id\",\n    \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login"
        }
      }
    },
    {
      "name": "3. Katalog - GET Daftar Buku Terpaginasi + HATEOAS",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bukus?per_page=5&sort=judul&dir=asc",
          "query": [
            {
              "key": "per_page",
              "value": "5"
            },
            {
              "key": "sort",
              "value": "judul"
            },
            {
              "key": "dir",
              "value": "asc"
            }
          ]
        }
      }
    },
    {
      "name": "4. Katalog - POST Tambah Buku Baru (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"isbn\": \"978-602-9999\",\n    \"judul\": \"Sistem Terdistribusi & Microservices\",\n    \"penulis\": \"Josef Christian Marpaung\",\n    \"penerbit\": \"Del Press\",\n    \"tahun_terbit\": 2026,\n    \"kategori_id\": 1,\n    \"stok\": 5,\n    \"sinopsis\": \"Buku baru pengujian POST REST API 201 Created.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/bukus"
        }
      }
    },
    {
      "name": "5a. Katalog - PUT Ganti Total Representasi Buku",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"isbn\": \"978-602-9999\",\n    \"judul\": \"Sistem Terdistribusi & Microservices (Full PUT)\",\n    \"penulis\": \"Josef Christian Marpaung\",\n    \"penerbit\": \"Del Press\",\n    \"tahun_terbit\": 2026,\n    \"kategori_id\": 1,\n    \"stok\": 8\n}"
        },
        "url": {
          "raw": "{{base_url}}/bukus/4"
        }
      }
    },
    {
      "name": "5b. Katalog - PATCH Update Sebagian Kolom Stok",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"stok\": 12\n}"
        },
        "url": {
          "raw": "{{base_url}}/bukus/4"
        }
      }
    },
    {
      "name": "6a. Sirkulasi - POST Peminjaman Buku ACID (Stok -1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"buku_id\": 2,\n    \"nim_peminjam\": \"12S24099\",\n    \"nama_peminjam\": \"Siti Nurhaliza\",\n    \"durasi_hari\": 7\n}"
        },
        "url": {
          "raw": "{{base_url}}/peminjamans"
        }
      }
    },
    {
      "name": "6b. Sirkulasi - Penolakan 409 Duplikasi Pinjaman Aktif",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"buku_id\": 2,\n    \"nim_peminjam\": \"12S24099\",\n    \"nama_peminjam\": \"Siti Nurhaliza\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/peminjamans"
        }
      }
    },
    {
      "name": "6c. Sirkulasi - Penolakan 422 Stok Buku Habis",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"buku_id\": 1,\n    \"nim_peminjam\": \"12S24050\",\n    \"nama_peminjam\": \"Budi Santoso\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/peminjamans"
        }
      }
    },
    {
      "name": "7. Consumer - GET Referensi Eksternal OpenLibrary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/bukus/2/referensi-eksternal"
        }
      }
    }
  ]
}